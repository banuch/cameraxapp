<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary">
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginStart="8dp"

        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/primary"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonsLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Zoom Control -->
        <LinearLayout
            android:id="@+id/zoomControlLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/black"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/zoomIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/zoom"
                android:src="@android:drawable/ic_menu_zoom"
                app:tint="@android:color/white" />

            <SeekBar
                android:id="@+id/zoomSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="28dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"

                android:thumb="@drawable/custom_thumb" />

        </LinearLayout>

        <!-- Exposure Control -->
        <LinearLayout
            android:id="@+id/exposureControlLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:background="@color/black"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/exposureIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/exposure"
                app:srcCompat="@drawable/brightness"
                app:tint="@android:color/white" />

            <SeekBar
                android:id="@+id/exposureSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="28dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:progress="50"
                android:thumb="@drawable/custom_thumb_exposer" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/thresholdSeekBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:background="@color/black"
            android:visibility="gone"

            android:orientation="horizontal">

            <ImageView
                android:id="@+id/thresholdSeekBarImage"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/exposure"
                app:srcCompat="@drawable/ic_model_select"
                app:tint="@android:color/white" />

            <SeekBar
                android:id="@+id/thresholdSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="28dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:progress="50"
                android:thumb="@drawable/custom_thumb_exposer" />
        </LinearLayout>
    </LinearLayout>



</androidx.coordinatorlayout.widget.CoordinatorLayout>